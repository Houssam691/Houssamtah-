---
/**
 * ===========================================================================
 * 404  —  `/404.html`
 * ---------------------------------------------------------------------------
 * Static hosts serve a single 404 document, so it is written in the only
 * language of the site and points to the main pages.
 * ===========================================================================
 */
import { site } from '~/config/site';
import { localizedPath, useDict } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Section from '~/components/Section.astro';
import Button from '~/components/Button.astro';

const locale = 'en' as const;
const t = useDict(locale);
const keyPages = ['/services', '/work', '/process', '/pricing', '/contact', '/faq'];
---

<BaseLayout
  path="/"
  locale={locale}
  title={t.seo.notFound.title}
  description={t.seo.notFound.description}
>
  <Section size="lg" class="pt-20 sm:pt-28">
    <div class="mx-auto max-w-2xl text-center">
      <p class="font-mono text-2xs uppercase tracking-[0.16em] text-accent">404</p>
      <h1 class="mt-6 text-4xl sm:text-5xl">{t.common.notFoundTitle}</h1>
      <p class="mt-6 text-lg text-muted text-pretty">{t.common.notFoundBody}</p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href={localizedPath('/', locale)} variant="primary" size="lg" magnetic>
          {t.common.backHome}
        </Button>
        <Button href={localizedPath('/contact', locale)} variant="secondary" size="lg">
          {t.nav.cta}
        </Button>
      </div>

      <nav aria-label={t.footer.navigation} class="mt-16">
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm">
          {
            keyPages.map((href) => {
              const label = t.nav.items.find((item) => item.href === href)?.label ?? href;
              return (
                <li>
                  <a href={localizedPath(href, locale)} class="link-underline text-muted hover:text-fg">
                    {label}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>

      <p class="mt-12 text-xs text-subtle">
        <a href={`mailto:${site.email}`} class="link-underline">
          {site.email}
        </a>
      </p>
    </div>
  </Section>
</BaseLayout>