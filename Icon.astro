---
/**
 * Abstract "code-inspired" icon set.
 * Every glyph is drawn with strokes on a 24×24 grid, inherits `currentColor`
 * and is hidden from assistive technology (labels always come from text).
 */
export type IconName =
  | 'window'
  | 'terminal'
  | 'flow'
  | 'spark'
  | 'gauge'
  | 'server'
  | 'shield'
  | 'layers'
  | 'cursor'
  | 'nodes'
  | 'mail'
  | 'phone'
  | 'calendar'
  | 'check'
  | 'arrow';

interface Props {
  name: IconName | string;
  class?: string;
  size?: string;
  strokeWidth?: number;
}

const { name, class: className = 'size-5', strokeWidth = 1.5 } = Astro.props;
const common = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': strokeWidth,
  'stroke-linecap': 'round' as const,
  'stroke-linejoin': 'round' as const,
};
---

<svg
  viewBox="0 0 24 24"
  class={className}
  aria-hidden="true"
  focusable="false"
  {...common}
>
  {name === 'window' && <><rect x="2.75" y="4" width="18.5" height="16" rx="2.5" /><path d="M2.75 8.25h18.5" /><path d="M6 6.15h.01M8.6 6.15h.01" /></>}
  {name === 'terminal' && <><rect x="2.75" y="4.5" width="18.5" height="15" rx="2.5" /><path d="M6.5 10l2.5 2.25-2.5 2.25M12.5 15h5" /></>}
  {name === 'flow' && <><rect x="2.5" y="3.5" width="7" height="6" rx="1.75" /><rect x="14.5" y="14.5" width="7" height="6" rx="1.75" /><path d="M9.5 6.5h3.25a2 2 0 012 2v6" /><path d="M12.75 12.5l2 2 2-2" /></>}
  {name === 'spark' && <><path d="M12 3l1.9 5.35L19.5 10l-5.6 1.65L12 17l-1.9-5.35L4.5 10l5.6-1.65L12 3Z" /><path d="M18.5 16.5l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2Z" /></>}
  {name === 'gauge' && <><path d="M3.75 17.5a9 9 0 1116.5 0" /><path d="M12 13.5l4-4" /><circle cx="12" cy="14.5" r="1.4" /></>}
  {name === 'server' && <><rect x="3" y="4" width="18" height="6.5" rx="2" /><rect x="3" y="13.5" width="18" height="6.5" rx="2" /><path d="M6.5 7.25h.01M6.5 16.75h.01" /></>}
  {name === 'shield' && <><path d="M12 3l7.5 2.75v5.5c0 4.4-3 8.1-7.5 9.25-4.5-1.15-7.5-4.85-7.5-9.25V5.75L12 3Z" /><path d="M9 11.75l2.25 2.25 4-4.25" /></>}
  {name === 'layers' && <><path d="M12 3.5l8.5 4.25L12 12 3.5 7.75 12 3.5Z" /><path d="M3.5 12.25L12 16.5l8.5-4.25M3.5 16.5L12 20.75l8.5-4.25" /></>}
  {name === 'cursor' && <><path d="M5.5 3.5l13.5 7.75-6 1.5-2.5 5.75L5.5 3.5Z" /></>}
  {name === 'nodes' && <><circle cx="6" cy="6" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="12" cy="18" r="2.5" /><path d="M8.5 6h7M7.25 8.25L10.9 16M16.75 8.25L13.1 16" /></>}
  {name === 'mail' && <><rect x="2.75" y="5" width="18.5" height="14" rx="2.5" /><path d="M3.5 7.5l8.5 6 8.5-6" /></>}
  {name === 'phone' && <><path d="M7.5 3.5h9a2 2 0 012 2v13a2 2 0 01-2 2h-9a2 2 0 01-2-2v-13a2 2 0 012-2Z" /><path d="M10.75 17.5h2.5" /></>}
  {name === 'calendar' && <><rect x="3.25" y="5" width="17.5" height="16" rx="2.5" /><path d="M3.25 9.75h17.5M8 3v4M16 3v4" /></>}
  {name === 'check' && <path d="M4.5 12.5l5 5 10-11" />}
  {name === 'arrow' && <><path d="M4 12h16M14 6l6 6-6 6" /></>}
</svg>