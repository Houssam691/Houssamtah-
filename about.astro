---
/**
 * ===========================================================================
 * ABOUT  —  `/about/`
 * ===========================================================================
 */
import { site } from '~/config/site';
import { localizedPath, useDict, type Locale } from '~/i18n';
import type { Dict } from '~/content/types';
import { localeStaticPaths } from '~/lib/paths';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Section from '~/components/Section.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import Notice from '~/components/Notice.astro';
import Button from '~/components/Button.astro';
import Icon from '~/components/Icon.astro';

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props as { locale: Locale };
const t: Dict = useDict(locale);
---

<BaseLayout
  path="/about"
  locale={locale}
  title={t.seo.about.title}
  description={t.seo.about.description}
>
  <PageHero
    eyebrow={t.about.eyebrow}
    title={t.about.title}
    lead={t.about.intro}
    locale={locale}
    breadcrumbsLabel={t.footer.navigation}
    crumbs={[
      { label: t.brand.name, href: '/' },
      { label: t.seo.about.title },
    ]}
  />

  {/* =========================================================== STORY */}
  <Section size="lg">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading title={t.about.story.title} size="md" />
      </div>
      <div class="prose-site lg:col-span-8">
        {t.about.story.body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </Section>

  {/* ========================================================== VALUES */}
  <Section tone="elevated" size="lg">
    <SectionHeading title={t.about.valuesTitle} size="md" />

    <ul class="stagger mt-12 grid gap-x-10 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.about.values.map((value, index) => (
          <li class:list={['reveal', index % 3 > 0 && `reveal-delay-${index % 3}`]} data-revealed="false">
            <span class="grid size-9 place-items-center rounded-full border border-line text-accent" aria-hidden="true">
              <Icon name="spark" class="size-4" />
            </span>
            <h3 class="mt-5 text-lg">{value.title}</h3>
            <p class="mt-2.5 text-sm text-muted text-pretty">{value.body}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ======================================================= WORKING */}
  <Section size="lg">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading title={t.about.workingTitle} size="md" />
      </div>
      <ol class="grid gap-4 lg:col-span-7">
        {
          t.about.working.map((item, index) => (
            <li class="flex gap-5 rounded-md border border-line bg-surface/60 px-6 py-5">
              <span class="font-mono text-2xs text-accent nums" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-base font-medium">{item.title}</h3>
                <p class="mt-2 text-sm text-muted text-pretty">{item.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  {/* ====================================================== STANDARDS */}
  <Section tone="elevated" size="lg">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading title={t.about.standards.title} size="md" />
        <p class="mt-5 text-sm text-muted text-pretty">{t.about.standards.body}</p>
      </div>

      <ul class="grid gap-4 lg:col-span-8 sm:grid-cols-2">
        {
          t.about.standards.items.map((item) => (
            <li class="rounded-lg border border-line bg-surface p-6">
              <div class="flex items-center gap-2.5">
                <Icon name="shield" class="size-4.5 text-accent" />
                <h3 class="text-base font-medium">{item.label}</h3>
              </div>
              <p class="mt-3 text-sm text-muted text-pretty">{item.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  {/* ============================================================= AI */}
  <Section size="lg">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading title={t.about.ai.title} size="md" />
        <div class="mt-6 space-y-4">
          <Notice icon="spark" title={t.about.ai.title}>
            {t.about.ai.review}
          </Notice>
        </div>
      </div>
      <div class="prose-site lg:col-span-8">
        {t.about.ai.body.map((paragraph) => <p>{paragraph}</p>)}
        <p class="mt-6 rounded-md border border-line bg-surface/60 px-5 py-4 text-sm">
          {t.about.ai.notice}
        </p>
      </div>
    </div>
  </Section>

  {/* ============================================================ TEAM */}
  <Section tone="elevated" size="lg">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading title={t.about.team.title} size="md" />
        <p class="mt-5 text-sm text-muted text-pretty">{t.about.team.body}</p>
        <p class="mt-5 flex items-center gap-2 text-xs text-subtle">
          <Icon name="mail" class="size-4" />
          <span>{site.location.label}</span>
        </p>
      </div>

      <ul class="grid gap-4 lg:col-span-8 sm:grid-cols-2">
        {
          t.about.team.slots.map((slot) => (
            <li class="rounded-lg border border-dashed border-line-strong bg-surface/40 p-6">
              <p class="font-mono text-2xs uppercase tracking-[0.14em] text-subtle">{slot.role}</p>
              {slot.name && <p class="mt-3 font-display text-lg font-medium text-muted">{slot.name}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section size="lg" class="text-center">
    <div class="mx-auto max-w-2xl">
      <h2 class="text-4xl">{t.about.cta.title}</h2>
      <p class="mt-5 text-md text-muted text-pretty">{t.about.cta.body}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href={localizedPath('/contact', locale)} variant="primary" size="lg" magnetic>
          {t.about.cta.primary}
        </Button>
        <Button href={localizedPath('/work', locale)} variant="secondary" size="lg">
          {t.seo.work.title}
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>