---
import type { Service } from '~/content/types';
import { localizedPath, type Locale } from '~/i18n';
import Icon from '~/components/Icon.astro';

interface Props {
  service: Service;
  locale: Locale;
  /** H2 on the services index, H3 elsewhere: keeps the heading order valid. */
  headingLevel?: 'h2' | 'h3';
  delay?: number;
}

const { service, locale, headingLevel = 'h3', delay = 0 } = Astro.props;
/** `delay` is a millisecond offset; the CSS exposes it as fixed step classes. */
const delayStep = Math.min(11, Math.round(delay / 90));
const Heading = headingLevel;
---

<article
  class:list={[
    'card-hover group relative flex flex-col rounded-lg border border-line bg-surface p-6 sm:p-7',
    delayStep > 0 && `reveal-delay-${delayStep}`,
  ]}
>
  <div class="flex items-start justify-between gap-4">
    <span
      class="grid size-11 place-items-center rounded-md bg-accent-soft text-accent"
      aria-hidden="true"
    >
      <Icon name={service.icon} class="size-5.5" />
    </span>
    <span class="font-mono text-2xs text-subtle nums">{service.index}</span>
  </div>

  <Heading class="mt-6 text-xl leading-tight">
    <a href={localizedPath(`/services/${service.slug}`, locale)} class="after:absolute after:inset-0">
      {service.title}
    </a>
  </Heading>

  <p class="mt-3 flex-1 text-sm text-muted text-pretty">{service.short}</p>

  <span
    class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium text-accent"
    aria-hidden="true"
  >
    <Icon
      name="arrow"
      class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
    />
  </span>
</article>