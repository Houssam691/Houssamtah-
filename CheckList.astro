---
/**
 * Checklist of deliverables / inclusions. Semantic list, accent markers,
 * automatic two-column layout on wide screens.
 */
interface Props {
  items: string[];
  columns?: 1 | 2 | 3;
  size?: 'sm' | 'md';
  class?: string;
}

const { items, columns = 1, size = 'md', class: className = '' } = Astro.props;

const cols: Record<number, string> = {
  1: 'sm:grid-cols-1',
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
};
---

<ul
  class:list={[
    'grid gap-x-8 gap-y-3',
    cols[columns],
    size === 'sm' ? 'text-sm' : 'text-md',
    className,
  ]}
>
  {
    items.map((item) => (
      <li class="flex items-start gap-3 text-pretty">
        <svg
          viewBox="0 0 20 20"
          class="mt-1 size-4 shrink-0 text-accent"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4.5 10.5l3.5 3.5 7.5-8.5" />
        </svg>
        <span class="text-muted">{item}</span>
      </li>
    ))
  }
</ul>