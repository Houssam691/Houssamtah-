---
import type { DemoWork } from '~/content/types';
import { localizedPath, type Locale } from '~/i18n';
import DemoMockup from '~/components/DemoMockup.astro';

interface Props {
  project: DemoWork;
  locale: Locale;
  demoNotice: string;
  headingLevel?: 'h2' | 'h3';
  delay?: number;
}

const { project, locale, demoNotice, headingLevel = 'h3', delay = 0 } = Astro.props;
/** `delay` is a millisecond offset; the CSS exposes it as fixed step classes. */
const delayStep = Math.min(11, Math.round(delay / 90));
const Heading = headingLevel;
---

<article
  class:list={[
    'card-hover reveal group relative flex flex-col overflow-hidden rounded-lg border border-line bg-surface',
    delayStep > 0 && `reveal-delay-${delayStep}`,
  ]}
  data-revealed="false"
>
  <div class="relative border-b border-line p-4 pb-0">
    <DemoMockup variant={project.mockup} class="[&>div]:shadow-none" />
    <span
      class="absolute top-6 start-6 rounded-full bg-accent px-2.5 py-1 text-2xs font-medium text-accent-fg"
    >
      {project.badge}
    </span>
  </div>

  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="font-mono text-2xs text-subtle">{project.subtitle}</p>
    <Heading class="mt-3 text-xl leading-tight">
      <a href={localizedPath(`/work/${project.slug}`, locale)} class="after:absolute after:inset-0">
        {project.title}
      </a>
    </Heading>

    <p class="mt-3 flex-1 text-sm text-muted text-pretty">{project.summary}</p>

    <ul class="mt-5 flex flex-wrap gap-1.5">
      {project.stack.slice(0, 4).map((item) => (
        <li class="rounded-full border border-line px-2.5 py-0.5 font-mono text-2xs text-subtle">
          {item}
        </li>
      ))}
    </ul>

    <p class="mt-6 border-t border-line pt-4 text-2xs leading-relaxed text-subtle">
      {demoNotice}
    </p>
  </div>
</article>