---
/**
 * ===========================================================================
 * WORK INDEX  —  `/work/`
 * ---------------------------------------------------------------------------
 * Every project listed here is a demonstration. The disclaimer is repeated at
 * three levels on purpose: page hero, section notice and every card.
 * ===========================================================================
 */
import { localizedPath, useDict, type Locale } from '~/i18n';
import type { Dict } from '~/content/types';
import { localeStaticPaths } from '~/lib/paths';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageHero from '~/components/PageHero.astro';
import Section from '~/components/Section.astro';
import SectionHeading from '~/components/SectionHeading.astro';
import DemoCard from '~/components/DemoCard.astro';
import Notice from '~/components/Notice.astro';
import CtaBand from '~/components/CtaBand.astro';

export const getStaticPaths = () => localeStaticPaths();

const { locale } = Astro.props as { locale: Locale };
const t: Dict = useDict(locale);

const demos = t.work.demos;
const slots = t.work.slots;
const notice = t.work.demoNoticeBody;

const schema = [
  {
    '@type': 'CollectionPage',
    name: t.work.title,
    description: notice,
    hasPart: demos.map((project) => ({
      '@type': 'CreativeWork',
      name: project.title,
      description: project.summary,
      url: new URL(localizedPath(`/work/${project.slug}`, locale), Astro.site).href,
    })),
  },
];
---

<BaseLayout
  path="/work"
  locale={locale}
  title={t.seo.work.title}
  description={t.seo.work.description}
  schema={schema}
>
  <PageHero
    eyebrow={t.work.eyebrow}
    title={t.work.title}
    lead={t.work.intro}
    locale={locale}
    breadcrumbsLabel={t.footer.navigation}
    crumbs={[
      { label: t.brand.name, href: '/' },
      { label: t.seo.work.title },
    ]}
  />

  <Section size="lg" class="pt-0 sm:pt-0">
    <Notice tone="accent" icon="alert" title={t.work.disclaimerTitle}>
      {t.work.disclaimerBody}
    </Notice>

    <div class="mt-14">
      <SectionHeading title={t.work.indexTitle} size="md" />
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      {
        demos.map((project, index) => (
          <DemoCard
            project={project}
            locale={locale}
            demoNotice={notice}
            delay={(index % 2) * 90}
          />
        ))
      }
    </div>
  </Section>

  {/* ============================================== RESERVED REAL SLOTS */}
  <Section tone="elevated" size="lg">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <SectionHeading title={t.work.slotsTitle} size="md" />
        <p class="mt-5 text-sm text-muted text-pretty">{t.work.slotsBody}</p>
      </div>

      <ul class="grid gap-4 lg:col-span-7">
        {
          slots.map((slot, index) => (
            <li class="rounded-lg border border-dashed border-line-strong bg-surface/40 p-6">
              <p class="font-mono text-2xs text-subtle nums">
                {String(index + 1).padStart(2, '0')} — {t.work.slotsTitle}
              </p>
              <p class="mt-3 font-display text-lg font-medium text-muted">{slot.title}</p>
              <p class="mt-2 text-sm text-subtle text-pretty">{slot.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <CtaBand
    title={t.work.ctaTitle}
    body={t.work.ctaBody}
    primary={t.work.ctaPrimary}
    secondary={t.seo.services.title}
    secondaryHref="/services"
    locale={locale}
  />
</BaseLayout>