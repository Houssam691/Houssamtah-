---
import { site } from '~/config/site';
import { localizedPath, type Locale } from '~/i18n';
import type { Dict } from '~/content/types';

interface Props {
  locale: Locale;
  t: Dict;
}

const { locale, t } = Astro.props;

const navItems = t.nav.items;
const services = t.services.items;
const legalLinks = [
  { label: t.seo.mentions.title, href: '/legal/mentions' },
  { label: t.seo.privacy.title, href: '/legal/privacy' },
  { label: t.seo.cgv.title, href: '/legal/cgv' },
];
const year = new Date().getFullYear();
---

<footer class="relative mt-auto border-t border-line bg-bg-elev">
  <div class="container-site py-14 sm:py-20">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12">
      {/* -------------------------------------------------------- Brand */}
      <div class="lg:col-span-4">
        <p class="font-display text-lg font-semibold tracking-tight">
          {site.brand}<span class="text-accent">.</span>
        </p>
        <p class="mt-3 max-w-xs text-sm text-muted text-pretty">{t.footer.tagline}</p>
        <p class="mt-5 flex items-center gap-2 text-xs text-subtle">
          <svg viewBox="0 0 24 24" class="size-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.7 2.5 15.3 0 18M12 3c-2.5 2.7-2.5 15.3 0 18" />
          </svg>
          <span>{t.footer.remoteNote}</span>
        </p>
      </div>

      {/* ----------------------------------------------------- Navigation */}
      <nav aria-labelledby="footer-nav" class="lg:col-span-3">
        <h2 id="footer-nav" class="eyebrow">{t.footer.navigation}</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={localizedPath(item.href, locale)}
                  class="link-underline text-muted transition-colors hover:text-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* ------------------------------------------------------- Services */}
      <nav aria-labelledby="footer-services" class="lg:col-span-3">
        <h2 id="footer-services" class="eyebrow">{t.footer.services}</h2>
        <ul class="mt-5 space-y-3 text-sm">
          {
            services.slice(0, 6).map((service) => (
              <li>
                <a
                  href={localizedPath(`/services/${service.slug}`, locale)}
                  class="link-underline text-muted transition-colors hover:text-fg"
                >
                  {service.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* -------------------------------------------------------- Contact */}
      <div class="lg:col-span-2">
        <h2 class="eyebrow">{t.footer.contact}</h2>
        <ul class="mt-5 space-y-3 text-sm">
          <li>
            <a href={`mailto:${site.email}`} class="link-underline break-all text-muted transition-colors hover:text-fg">
              {site.email}
            </a>
          </li>
          {
            site.phone && (
              <li>
                <a
                  href={`tel:${site.phone.replace(/\s/g, '')}`}
                  class="link-underline text-muted transition-colors hover:text-fg"
                >
                  {site.phone}
                </a>
              </li>
            )
          }
          {
            site.social.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="link-underline inline-flex items-center gap-1 text-muted transition-colors hover:text-fg"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.label}
                  <span class="sr-only">({t.common.externalLink})</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* ----------------------------------------------------- Bottom line */}
    <div
      class="mt-14 flex flex-col gap-6 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-xs text-subtle">
        <p>
          © {year} {site.brand}. {t.footer.rights}
        </p>
        <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {
            legalLinks.map((item) => (
              <li>
                <a
                  href={localizedPath(item.href, locale)}
                  class="link-underline transition-colors hover:text-fg"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>