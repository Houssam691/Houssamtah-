---
/**
 * Notice box. Used for every honesty statement on the site:
 * demo projects, placeholder pricing, scope limits, legal templates.
 */
interface Props {
  title?: string;
  tone?: 'neutral' | 'accent' | 'muted';
  icon?: 'info' | 'check' | 'alert' | 'spark';
  id?: string;
  class?: string;
}

const { title, tone = 'neutral', icon = 'info', id, class: className = '' } = Astro.props;

const tones: Record<string, string> = {
  neutral: 'border-line bg-surface/60',
  accent: 'border-accent/30 bg-accent-soft',
  muted: 'border-line bg-surface/30',
};
---

<aside
  id={id}
  role="note"
  class:list={['flex gap-4 rounded-md border p-5 sm:p-6', tones[tone], className]}
>
  <span
    class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full border border-line text-accent"
    aria-hidden="true"
  >
    {
      icon === 'check' && (
        <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8.5l3.5 3.5L13 5" />
        </svg>
      )
    }
    {
      icon === 'alert' && (
        <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M8 4.5v5M8 12h.01" />
          <circle cx="8" cy="8" r="6" />
        </svg>
      )
    }
    {
      icon === 'spark' && (
        <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
          <path d="M8 2l1.3 3.7L13 7l-3.7 1.3L8 12l-1.3-3.7L3 7l3.7-1.3L8 2Z" />
        </svg>
      )
    }
    {
      icon === 'info' && (
        <svg viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="8" cy="8" r="6" />
          <path d="M8 7.25v4M8 4.75h.01" />
        </svg>
      )
    }
  </span>

  <div class="min-w-0 flex-1">
    {title && <p class="font-display text-sm font-semibold text-fg">{title}</p>}
    <div class="text-sm leading-relaxed text-muted text-pretty empty:hidden">
      <slot />
    </div>
  </div>
</aside>